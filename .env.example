# ==============================================================================
# ispmon - Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# ISP Plan Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Free text plan description shown in alerts and reports
ISP_PLAN_NAME=My Internet Plan

# Advertised download and upload speeds in Mbps (must be > 0)
ISP_PLAN_SPEED=500
ISP_PLAN_UPLOAD_SPEED=500

# Contractual minimum speed thresholds in Mbps (must not exceed plan speeds)
# Single checks below these values are flagged as SLA violations
ISP_PLAN_THRESHOLD=150
ISP_PLAN_UPLOAD_THRESHOLD=150

# ------------------------------------------------------------------------------
# SLA Engine Configuration (Optional)
# ------------------------------------------------------------------------------
# Rolling assessment window in hours (default: 24)
SLA_WINDOW_HOURS=24

# Percentage of valid checks in window below threshold to declare breach (default: 20.0)
# A breach is declared if strictly greater than this threshold percentage
SLA_VIOLATION_PCT=20.0

# Minimum share of expected checks needed in window before evaluating SLA (default: 0.75)
SLA_MIN_COVERAGE=0.75

# Thresholds for counting "slow" incidents in periodic summaries (defaults to plan speeds)
# SPEED_ALERT_DOWNLOAD=500
# SPEED_ALERT_UPLOAD=500

# ------------------------------------------------------------------------------
# Monitoring Schedule & Timezone (Optional)
# ------------------------------------------------------------------------------
# Interval in minutes between speed tests (default: 30)
CHECK_INTERVAL_MINUTES=30

# Interval in hours for periodic summary alerts (default: 6)
SUMMARY_INTERVAL_HOURS=6

# Daily report schedule time (HH:MM format in TZ, default: 23:59)
DAILY_REPORT_TIME=23:59

# IANA timezone for daily report generation and log displays (default: UTC)
TZ=UTC

# ------------------------------------------------------------------------------
# Storage Configuration (Optional)
# ------------------------------------------------------------------------------
# Path to SQLite database file (default: data/ispmon.db, created if missing)
DB_PATH=data/ispmon.db

# Data retention period in days (default: 90, set to 0 to keep data forever)
# Automatically prunes network_checks and closed episodes once a day.
RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# Connectivity Probe & Outage Detection (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list of host:port targets for lightweight TCP checks (default: 1.1.1.1:443,9.9.9.9:443)
PROBE_TARGETS=1.1.1.1:443,9.9.9.9:443

# Probe execution interval in seconds (default: 60)
PROBE_INTERVAL_SECONDS=60

# Number of consecutive failed rounds required before declaring an outage (default: 3)
PROBE_FAIL_ROUNDS=3

# Per-target TCP connection timeout in seconds (default: 3)
PROBE_TIMEOUT_SECONDS=3

# ------------------------------------------------------------------------------
# Discord Notifications (Optional)
# ------------------------------------------------------------------------------
# Discord webhook URL. Leave empty to disable Discord notifications.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ------------------------------------------------------------------------------
# Email (SMTP) Notifications (Optional)
# ------------------------------------------------------------------------------
# Email notifications are enabled only if SERVER, USER, PASSWORD, and RECIPIENT are all set.
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password
EMAIL_RECIPIENT=you@example.com
